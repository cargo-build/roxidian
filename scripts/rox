#!/usr/bin/env bash
set -euo pipefail
root="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
url_path() {
    local LC_ALL=C value="$1" encoded='' character escaped index
    for ((index = 0; index < ${#value}; index++)); do
        character="${value:index:1}"
        case "$character" in
            [a-zA-Z0-9.~_/-]) encoded+="$character" ;;
            *) printf -v escaped '%%%02X' "'$character"; encoded+="$escaped" ;;
        esac
    done
    printf '%s' "$encoded"
}
if [[ -f "$root/VERSION" ]]; then
    binary="$root/bin/rox"
    runtime="path:$(url_path "$root/runtime")#runtime"
else
    binary="$root/target/release/rox"
    runtime="path:$(url_path "$root")#runtime"
fi
if [[ ! -x "$binary" ]]; then
    echo "rox: executable missing: $binary; rebuild or reinstall this distribution" >&2
    exit 1
fi
if [[ "${ROXIDIAN_RUNTIME_ROOT:-}" != "$root" ]]; then
    exec nix develop "$runtime" --no-write-lock-file -c env "ROXIDIAN_RUNTIME_ROOT=$root" "$root/scripts/rox" "$@"
fi
if command -v nvidia-offload >/dev/null 2>&1; then
    exec nvidia-offload "$binary" "$@"
fi
exec "$binary" "$@"
