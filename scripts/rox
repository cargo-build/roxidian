#!/usr/bin/env bash
set -euo pipefail
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
directory="${script%/*}"
root="${directory%/*}"
url_path() {
    local LC_ALL=C value="$1" encoded='' character escaped index
    for ((index = 0; index < ${#value}; index++)); do
        character="${value:index:1}"
        case "$character" in
            [a-zA-Z0-9.~_/-]) encoded+="$character" ;;
            *) printf -v escaped '%%%02X' "'$character"; encoded+="$escaped" ;;
        esac
    done
    printf '%s' "$encoded"
}
if [[ -f "$root/VERSION" ]]; then
    binary="$root/bin/rox"
    runtime="$root/runtime"
else
    binary="$root/target/release/rox"
    runtime="$root"
fi
if [[ ! -x "$binary" ]]; then
    echo "rox: executable missing: $binary; rebuild or reinstall this distribution" >&2
    exit 1
fi
launch=("$binary" "$@")
if command -v nvidia-offload >/dev/null 2>&1; then
    launch=(nvidia-offload "${launch[@]}")
fi
if [[ -r "$root/.runtime/library-path" ]] && IFS= read -r libraries < "$root/.runtime/library-path" && [[ -n "$libraries" ]]; then
    export LD_LIBRARY_PATH="$libraries"
    exec "${launch[@]}"
fi
exec nix develop "path:$(url_path "$runtime")#runtime" --no-write-lock-file -c "${launch[@]}"
